# ─── Accès (mono-utilisateur) ──────────────────────────────────────────────────
# Mot de passe unique protégeant l'accès public à l'application.
# À DÉFINIR toi-même (jamais commité). Choisis un mot de passe fort.
APP_PASSWORD=change-moi-en-un-mot-de-passe-fort

# Secret de signature du cookie de session (chaîne aléatoire longue).
# Générer avec :  openssl rand -hex 32
SESSION_SECRET=change-moi-une-longue-chaine-aleatoire-hex

# ─── Serveur (production, adapter-node) ────────────────────────────────────────
# URL publique EXACTE (protection CSRF d'adapter-node + cookie derrière Cloudflare).
ORIGIN=https://fittrack.romary.org
# Dans Docker : 0.0.0.0 pour écouter sur l'interface du conteneur
# (publié uniquement sur 127.0.0.1:8084 côté hôte par docker-compose).
HOST=0.0.0.0
PORT=3000

# ─── Base de données ───────────────────────────────────────────────────────────
# Chemin du fichier SQLite. Dans le conteneur : /app/data (volume ./data monté).
DB_PATH=/app/data/fittrack.db
